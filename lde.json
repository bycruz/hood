{
	"name": "hood",
	"description": "Cross platform graphics API for LuaJIT",
	"authors": ["David Cruz <david@bycruz.dev>"],
	"version": "0.1.3",
	"dependencies": {
		"glapi": { "version": "0.1.0" },
		"vkapi": { "version": "0.1.0" },
		"x11api": { "version": "0.1.0", "optional": true },
		"winapi": { "version": "0.1.0", "optional": true },
		"winit": { "version": "0.1.0" }
	},
	"features": {
		"windows": ["winapi"],
		"linux": ["x11api"]
	},
	"devDependencies": {
		"fs": { "version": "0.2.0" },
		"path": { "version": "0.1.0" }
	}
}
